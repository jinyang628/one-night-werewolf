.app-shell {
  height: 100vh;
  overflow: hidden;
  background:
    radial-gradient(circle at 20% 0%, rgba(232, 177, 93, 0.09), transparent 32%),
    #0c1113;
}

.status-bar {
  height: env(safe-area-inset-top);
  min-height: 20px;
}

.topbar {
  height: 84rpx;
  padding: 0 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.topbar__brand,
.eyebrow,
.section-label {
  color: #e8b15d;
  font-size: 23rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.language-button,
.back-button,
.icon-button,
.counter-button {
  margin: 0;
  padding: 0 18rpx;
  min-width: 0;
  background: transparent;
  color: #d7d8d6;
  font-size: 25rpx;
  line-height: 60rpx;
}

.screen {
  box-sizing: border-box;
  height: calc(100vh - env(safe-area-inset-top) - 84rpx);
  padding: 28rpx 36rpx calc(30rpx + env(safe-area-inset-bottom));
}

.screen--column {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.hero {
  padding: 70rpx 8rpx 62rpx;
  text-align: center;
}

.moon,
.sun,
.privacy-icon,
.trophy {
  color: #e8b15d;
  font-size: 92rpx;
  line-height: 1;
  text-align: center;
  text-shadow: 0 0 50rpx rgba(232, 177, 93, 0.28);
}

.hero__title,
.page-title {
  margin-top: 14rpx;
  color: #faf7f0;
  font-size: 52rpx;
  line-height: 1.14;
  font-weight: 850;
  letter-spacing: -2rpx;
}

.hero__subtitle {
  margin-top: 18rpx;
  color: rgba(244, 240, 232, 0.52);
  font-size: 27rpx;
}

.mode-card {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
  padding: 34rpx 28rpx;
  background: rgba(25, 32, 34, 0.96);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 30rpx;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.18);
}

.mode-card__icon {
  width: 76rpx;
  color: #e8b15d;
  font-size: 58rpx;
  text-align: center;
}

.mode-card__copy {
  flex: 1;
  margin-left: 25rpx;
}

.card-title {
  color: #f4f0e8;
  font-size: 30rpx;
  font-weight: 750;
}

.muted {
  margin-top: 7rpx;
  color: rgba(244, 240, 232, 0.58);
  font-size: 25rpx;
  line-height: 1.45;
}

.chevron {
  color: rgba(255, 255, 255, 0.35);
  font-size: 54rpx;
}

.centered {
  text-align: center;
}

.screen-heading {
  flex: 0 0 auto;
}

.back-button {
  margin-left: -18rpx;
  margin-bottom: 15rpx;
}

.button {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  border-radius: 22rpx;
  font-size: 29rpx;
  font-weight: 750;
  line-height: 88rpx;
}

.button[disabled],
.icon-button[disabled],
.counter-button[disabled] {
  opacity: 0.34;
}

.button--primary {
  background: #e8b15d;
  color: #17140f;
}

.button--secondary {
  border: 2rpx solid rgba(232, 177, 93, 0.55);
  background: rgba(232, 177, 93, 0.06);
  color: #f1ca8f;
}

.button--ghost {
  background: transparent;
  color: rgba(244, 240, 232, 0.55);
}

.button-row {
  display: flex;
  gap: 16rpx;
}

.button-row__item {
  flex: 1;
}

.grow-list {
  flex: 1;
  min-height: 0;
}

.player-row,
.selection-row,
.result-row,
.role-editor-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 14rpx;
  padding: 16rpx;
  background: #151b1d;
  border: 1rpx solid rgba(255, 255, 255, 0.075);
  border-radius: 24rpx;
}

.seat {
  flex: 0 0 62rpx;
  width: 62rpx;
  height: 62rpx;
  border: 1rpx solid rgba(232, 177, 93, 0.45);
  border-radius: 50%;
  background: rgba(232, 177, 93, 0.1);
  color: #e8b15d;
  font-weight: 800;
  line-height: 62rpx;
  text-align: center;
}

.player-input,
.player-name {
  flex: 1;
  color: #f4f0e8;
  font-size: 29rpx;
  font-weight: 650;
}

.icon-button {
  padding: 0;
  width: 52rpx;
  color: #aeb2b0;
}

.icon-button--danger {
  color: #e28a82;
}

.role-chips {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8rpx;
  max-height: 104rpx;
  overflow: hidden;
}

.role-chip,
.host-badge {
  padding: 8rpx 15rpx;
  border-radius: 999rpx;
  background: #20282b;
  color: #d9d7d0;
  font-size: 21rpx;
}

.room-entry-title {
  margin: 35rpx 0 45rpx;
}

.field {
  box-sizing: border-box;
  width: 100%;
  height: 96rpx;
  margin-bottom: 20rpx;
  padding: 0 26rpx;
  border-radius: 22rpx;
  background: #20282b;
  color: #f4f0e8;
}

.room-code-field {
  text-align: center;
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: 10rpx;
  text-transform: uppercase;
}

.divider {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 38rpx 0;
  color: rgba(255, 255, 255, 0.35);
  font-size: 21rpx;
}

.divider view {
  flex: 1;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.11);
}

.lobby {
  gap: 14rpx;
}

.room-code {
  color: #fff;
  font-size: 68rpx;
  font-weight: 850;
  letter-spacing: 16rpx;
  text-align: center;
}

.section-label {
  margin: 22rpx 0 5rpx;
  color: rgba(244, 240, 232, 0.45);
  letter-spacing: 2rpx;
}

.waiting {
  padding: 24rpx;
  color: rgba(244, 240, 232, 0.55);
  text-align: center;
}

.handoff,
.role-screen,
.discussion-screen {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 22rpx;
}

.handoff__button {
  margin-top: 70rpx;
}

.role-screen {
  gap: 25rpx;
}

.role-card {
  margin: 20rpx 0;
  padding: 48rpx 34rpx;
  border: 1rpx solid rgba(232, 177, 93, 0.36);
  border-radius: 38rpx;
  background: linear-gradient(145deg, #2e3a3d, #151b1d);
  box-shadow: 0 30rpx 65rpx rgba(0, 0, 0, 0.35);
}

.role-card__emoji {
  color: #e8b15d;
  font-size: 96rpx;
  line-height: 1;
  text-align: center;
}

.night-screen {
  gap: 15rpx;
}

.action-area {
  margin-top: 12rpx;
}

.info-panel,
.action-result {
  margin-bottom: 20rpx;
  padding: 30rpx;
  border-radius: 28rpx;
  background: #20282b;
}

.instruction {
  margin-bottom: 18rpx;
  color: #e0ded7;
  font-size: 27rpx;
  line-height: 1.5;
}

.center-picker,
.center-results,
.seen-cards {
  display: flex;
  gap: 14rpx;
  margin: 20rpx 0;
}

.center-card,
.center-result,
.seen-card {
  flex: 1;
  min-height: 130rpx;
  padding: 18rpx 8rpx;
  border: 1rpx solid rgba(232, 177, 93, 0.3);
  border-radius: 22rpx;
  background: #20282b;
  color: #e8b15d;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.35;
  text-align: center;
}

.center-card--selected {
  border-color: #e8b15d;
  background: rgba(232, 177, 93, 0.16);
  box-shadow: inset 0 0 0 2rpx rgba(232, 177, 93, 0.3);
}

.selection-row {
  justify-content: space-between;
  min-height: 62rpx;
  color: #f4f0e8;
  font-size: 29rpx;
}

.selection-row--selected {
  border-color: #e8b15d;
  background: rgba(232, 177, 93, 0.13);
}

.action-result {
  text-align: center;
}

.action-result__check {
  margin-bottom: 20rpx;
  color: #e8b15d;
  font-size: 72rpx;
}

.seen-card__icon {
  margin-bottom: 10rpx;
  font-size: 50rpx;
}

.timer {
  color: #f4f0e8;
  font-size: 112rpx;
  font-weight: 250;
  letter-spacing: 5rpx;
  text-align: center;
}

.discussion-players {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14rpx;
  margin: 30rpx 0;
}

.discussion-player {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 9rpx 18rpx 9rpx 9rpx;
  border-radius: 999rpx;
  background: #151b1d;
}

.discussion-player .seat {
  width: 46rpx;
  height: 46rpx;
  flex-basis: 46rpx;
  line-height: 46rpx;
}

.result-screen {
  padding-bottom: calc(45rpx + env(safe-area-inset-bottom));
}

.result-subtitle {
  margin: 14rpx 0 32rpx;
  color: #e8b15d;
  font-size: 29rpx;
  font-weight: 700;
  text-align: center;
}

.result-row {
  justify-content: space-between;
}

.result-row--eliminated {
  border-color: rgba(226, 138, 130, 0.65);
}

.vote-count {
  color: #e8b15d;
  font-weight: 800;
}

.center-result {
  color: #f4f0e8;
}

.gold {
  color: #e8b15d;
}

.result-screen .button {
  margin-top: 16rpx;
}

.modal-backdrop,
.loading-overlay {
  position: fixed;
  z-index: 20;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 35rpx;
  background: rgba(0, 0, 0, 0.75);
}

.modal {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: 86vh;
  padding: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 32rpx;
  background: #151b1d;
  box-shadow: 0 35rpx 90rpx rgba(0, 0, 0, 0.55);
}

.role-editor-list {
  height: 720rpx;
  margin: 25rpx 0;
}

.role-editor-row {
  padding: 14rpx;
  background: #20282b;
}

.role-editor-icon {
  width: 52rpx;
  color: #e8b15d;
  font-size: 38rpx;
  text-align: center;
}

.role-editor-copy {
  flex: 1;
  min-width: 0;
}

.role-editor-desc {
  max-width: 295rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.counter-button {
  width: 56rpx;
  padding: 0;
  border-radius: 50%;
  background: rgba(232, 177, 93, 0.1);
  color: #e8b15d;
}

.counter {
  width: 35rpx;
  text-align: center;
}

.loading-overlay {
  z-index: 30;
  background: rgba(0, 0, 0, 0.45);
}

.spinner {
  width: 66rpx;
  height: 66rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.18);
  border-top-color: #e8b15d;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.error-toast {
  position: fixed;
  z-index: 40;
  right: 28rpx;
  bottom: calc(30rpx + env(safe-area-inset-bottom));
  left: 28rpx;
  padding: 22rpx 25rpx;
  border: 1rpx solid rgba(255, 158, 149, 0.4);
  border-radius: 20rpx;
  background: #542b2b;
  color: #ffd8d3;
  font-size: 25rpx;
  box-shadow: 0 18rpx 45rpx rgba(0, 0, 0, 0.35);
}
